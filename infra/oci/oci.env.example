# Copy to oci.env and fill in. oci.env is gitignored — it holds account-specific OCIDs,
# not secrets (the private key lives in ~/.oci/, never in this repo).
#
#   cp infra/oci/oci.env.example infra/oci/oci.env

# Which ~/.oci/config profile to use. One profile per tenancy — that is how you keep
# the old account and the new one apart.
OCI_PROFILE=DAIMON2

# Compartment to build in. The tenancy OCID (root compartment) is fine for a personal
# account. Find it: oci --profile "$OCI_PROFILE" iam compartment list --all
OCI_COMPARTMENT_ID=

# Name prefix for every resource this creates, so it is obvious what to delete
# later. Also feeds the VCN DNS label: use lowercase letters and digits, and
# make sure at least one letter survives (max 15 chars are used).
STACK_NAME=daimon

# --- Shape -------------------------------------------------------------------
# Always Free ARM allowance is 4 OCPUs and 24 GB of RAM TOTAL across all A1 instances
# in the tenancy. One 4/24 box spends all of it. Drop to 1/6 if you want four boxes,
# or if 4/24 keeps hitting capacity limits (smaller shapes are easier to place).
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=4
OCI_MEMORY_GB=24
OCI_BOOT_VOLUME_GB=50

# Image to launch. Leave blank to auto-pick the newest matching image.
OCI_OS="Canonical Ubuntu"
OCI_OS_VERSION="24.04"
OCI_IMAGE_ID=

# --- Access ------------------------------------------------------------------
# Public key installed on the instance. Generate with:
#   ssh-keygen -t ed25519 -f ~/.ssh/oci_daimon2 -C daimon2
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/oci_daimon2.pub"
SSH_PRIVATE_KEY_FILE="$HOME/.ssh/oci_daimon2"

# Ubuntu images log in as 'ubuntu'; Oracle Linux images as 'opc'.
SSH_USER=ubuntu

# --- Site --------------------------------------------------------------------
# Domain to serve daimon-carads from. Point its A record at the instance IP BEFORE
# running 03-deploy-site.sh, or Caddy cannot get a certificate.
# Leave blank to serve plain HTTP on the raw IP (fine for a smoke test).
SITE_DOMAIN=

# Also serve www.$SITE_DOMAIN (as a redirect to the apex). Opt-in because it
# needs its own A/CNAME record — without one, certificate requests for www
# fail forever in the background.
SITE_WWW=false
